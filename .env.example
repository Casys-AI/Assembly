ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_PROVIDER=claude

# Required operational PostgreSQL connection. Keep actual credentials in this
# private host environment file, outside model sources and provider messages.
# The values below are the local development database of compose.yaml
# (`deno task db:up` from the repository root); replace them for any other host.
ASSEMBLY_DATABASE_URL=postgresql://assembly:assembly@127.0.0.1:55432/assembly_dev
# Administrative direct connection for the Prisma migration CLI only.
ASSEMBLY_DATABASE_DIRECT_URL=postgresql://assembly:assembly@127.0.0.1:55432/assembly_dev
# One running host uses at most 10 connections: Prisma 4, queue 2,
# official checkpoints 2, official graph store 2. Operators share these pools.

# Product settings use ASSEMBLY_*. Corresponding ASE_* aliases remain supported.
# A defined canonical value takes precedence, including an empty value.
# Leave optional settings commented to retain their defaults.
# ASSEMBLY_DEMO_DATA_DIR=.data/demo
# ASSEMBLY_MODEL_PROJECT_DIR=/absolute/path/to/model-project
# ASSEMBLY_BACKEND_URL=http://127.0.0.1:4311
# ASSEMBLY_RUST_BIN_DIR=/absolute/path/to/rust-toolchain/bin
