{
  "unstable": [
    "kv"
  ],
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "types": [
      "npm:@types/node@24.10.1",
      "npm:@types/pg@8.23.1"
    ]
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@4.13.14",
    "@logtape/logtape": "jsr:@logtape/logtape@2.4.2",
    "ajv": "npm:ajv@8.20.0",
    "ajv/dist/2020.js": "npm:ajv@8.20.0/dist/2020.js",
    "@kitsonk/kv-toolbox/blob": "jsr:@kitsonk/kv-toolbox@0.31.0/blob",
    "diff": "npm:diff@9.0.0",
    "ldkit": "npm:ldkit@2.10.1",
    "rdf-validate-shacl": "npm:rdf-validate-shacl@0.6.0",
    "@rdfjs/parser-n3": "npm:@rdfjs/parser-n3@2.1.0",
    "@rdfjs/dataset": "npm:@rdfjs/dataset@2.0.1",
    "ldkit/rdf": "npm:ldkit@2.10.1/rdf",
    "prisma": "npm:prisma@7.10.1",
    "prisma/config": "npm:prisma@7.10.1/config",
    "@prisma/client": "npm:@prisma/client@7.10.1",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@7.10.1",
    "pg": "npm:pg@8.23.1",
    "pg-boss": "npm:pg-boss@12.38.0",
    "@langchain/langgraph": "npm:@langchain/langgraph@1.5.3",
    "@langchain/langgraph-checkpoint-postgres": "npm:@langchain/langgraph-checkpoint-postgres@1.1.2",
    "@langchain/langgraph-checkpoint-postgres/store": "npm:@langchain/langgraph-checkpoint-postgres@1.1.2/store",
    "@langchain/core/messages": "npm:@langchain/core@1.2.17/messages",
    "@langchain/core/runnables": "npm:@langchain/core@1.2.17/runnables",
    "@langchain/core/singletons": "npm:@langchain/core@1.2.17/singletons",
    "@langchain/core/tools": "npm:@langchain/core@1.2.17/tools",
    "@langchain/core/language_models/chat_models": "npm:@langchain/core@1.2.17/language_models/chat_models",
    "@langchain/core/outputs": "npm:@langchain/core@1.2.17/outputs",
    "@langchain/anthropic": "npm:@langchain/anthropic@1.5.12"
  },
  "tasks": {
    "dev": "ASSEMBLY_ENV=development deno task ui:dev",
    "ui:dev": "ASSEMBLY_ENV=development .data/toolchains/deno-v2.9.7/deno task --cwd frontend dev",
    "model:project": ".data/toolchains/deno-v2.9.7/deno run --no-prompt --allow-read --allow-write --allow-env=PATH --allow-run=git,.data/toolchains/deno-v2.9.7/deno tools/model-project.ts",
    "setup": "deno run --no-prompt --allow-read --allow-write=.data/toolchains --allow-env=GITHUB_TOKEN,GH_TOKEN,PATH,HOME --allow-net=api.github.com,release-assets.githubusercontent.com,objects.githubusercontent.com tools/setup.ts",
    "setup:source": "deno run --no-prompt --allow-read --allow-write=.data/toolchains,native/toolkit,native/semantic-index --allow-env=PATH,HOME,ASSEMBLY_RUST_BIN_DIR,ASE_RUST_BIN_DIR,TMPDIR --allow-run --allow-net=registry.npmjs.org tools/setup.ts --source",
    "model:setup": "deno task setup",
    "model:toolkit:setup": "deno run --no-prompt --allow-read --allow-write=.data/toolchains --allow-env=GITHUB_TOKEN,GH_TOKEN,PATH,HOME --allow-net=api.github.com,release-assets.githubusercontent.com,objects.githubusercontent.com tools/setup-sysml-toolkit.ts",
    "model:toolkit:setup:source": "deno run --no-prompt --allow-read --allow-write=.data/toolchains,native/toolkit --allow-env=PATH,HOME,ASSEMBLY_RUST_BIN_DIR,ASE_RUST_BIN_DIR,TMPDIR --allow-run --allow-net=registry.npmjs.org tools/setup-sysml-toolkit.ts --source",
    "check": ".data/toolchains/deno-v2.9.7/deno check src test tools",
    "lint": ".data/toolchains/deno-v2.9.7/deno lint src test tools",
    "fmt": ".data/toolchains/deno-v2.9.7/deno fmt src test tools docs README.md deno.json",
    "fmt:check": ".data/toolchains/deno-v2.9.7/deno fmt --check src test tools docs README.md deno.json",
    "test": {
      "description": "Backend unit and setup tests, then frontend SSR and DOM tests, on parallel workers (runner profile workspace)",
      "command": ".data/toolchains/deno-v2.9.7/deno run --no-prompt --allow-read --allow-write --allow-env --allow-run --allow-sys=uid,gid tools/test-runner.ts workspace"
    },
    "test:unit": ".data/toolchains/deno-v2.9.7/deno run --no-prompt --allow-read --allow-write --allow-env --allow-run --allow-sys=uid,gid tools/test-runner.ts unit",
    "test:setup": ".data/toolchains/deno-v2.9.7/deno run --no-prompt --allow-read --allow-write --allow-env --allow-run --allow-sys=uid,gid tools/test-runner.ts setup",
    "test:integration": ".data/toolchains/deno-v2.9.7/deno run --no-prompt --allow-read --allow-write --allow-env --allow-run --allow-sys=uid,gid tools/test-runner.ts integration",
    "test:integration:full": ".data/toolchains/deno-v2.9.7/deno run --no-prompt --allow-read --allow-write --allow-env --allow-run --allow-sys=uid,gid tools/test-runner.ts integration-full",
    "test:toolkit": ".data/toolchains/deno-v2.9.7/deno run --no-prompt --allow-read --allow-write --allow-env --allow-run --allow-sys=uid,gid tools/test-runner.ts toolkit",
    "test:full": ".data/toolchains/deno-v2.9.7/deno run --no-prompt --allow-read --allow-write --allow-env --allow-run --allow-sys=uid,gid tools/test-runner.ts full",
    "test:heavy": ".data/toolchains/deno-v2.9.7/deno run --no-prompt --allow-read --allow-write --allow-env --allow-run --allow-sys=uid,gid tools/test-runner.ts heavy",
    "ui:build": ".data/toolchains/deno-v2.9.7/deno task --cwd frontend build && deno task ui:verify",
    "ui:verify": ".data/toolchains/deno-v2.9.7/deno run --no-prompt --allow-read=frontend/_fresh --allow-env tools/verify-frontend.ts",
    "ui:check": ".data/toolchains/deno-v2.9.7/deno task --cwd frontend check",
    "ui:test": ".data/toolchains/deno-v2.9.7/deno task --cwd frontend test",
    "ui:quality": ".data/toolchains/deno-v2.9.7/deno task --cwd frontend quality",
    "quality": "deno task fmt:check && deno task lint && deno task check && deno task --cwd frontend fmt:check && deno task --cwd frontend lint && deno task ui:check && deno task test",
    "serve": ".data/toolchains/deno-v2.9.7/deno run --env-file=.env --no-prompt --allow-read --allow-write --allow-env --allow-run --allow-net --allow-sys=hostname,systemMemoryInfo,cpus --allow-ffi=./node_modules,.data/toolchains src/main.ts",
    "system": ".data/toolchains/deno-v2.9.7/deno run --no-prompt --allow-read --allow-write --allow-env --allow-run --allow-net=127.0.0.1,localhost tools/system.ts",
    "model:semantic:setup": "deno run --no-prompt --allow-read --allow-write=.data/toolchains --allow-env=GITHUB_TOKEN,GH_TOKEN,PATH,HOME --allow-net=api.github.com,release-assets.githubusercontent.com,objects.githubusercontent.com tools/setup-semantic-index.ts",
    "model:semantic:setup:source": "deno run --no-prompt --allow-read --allow-write=.data/toolchains,native/semantic-index --allow-env=PATH,HOME,ASSEMBLY_RUST_BIN_DIR,ASE_RUST_BIN_DIR,TMPDIR --allow-run --allow-net=registry.npmjs.org tools/setup-semantic-index.ts --source",
    "test:postgres-toolkit": ".data/toolchains/deno-v2.9.7/deno run --no-prompt --allow-read --allow-write --allow-env --allow-run --allow-sys=uid,gid tools/test-runner.ts postgres-toolkit",
    "test:postgres": ".data/toolchains/deno-v2.9.7/deno run --no-prompt --allow-read --allow-write --allow-env --allow-run --allow-sys=uid,gid tools/test-runner.ts postgres",
    "test:changed": ".data/toolchains/deno-v2.9.7/deno run --no-prompt --allow-read --allow-write --allow-env --allow-run --allow-sys=uid,gid tools/test-runner.ts changed",
    "test:semantic": ".data/toolchains/deno-v2.9.7/deno run --no-prompt --allow-read --allow-write --allow-env --allow-run --allow-sys=uid,gid tools/test-runner.ts semantic",
    "dev:backend": "ASSEMBLY_ENV=development deno task system serve",
    "db:migrate": "node --env-file=.env node_modules/prisma/build/index.js migrate deploy --config prisma/prisma.config.ts"
  }
}
