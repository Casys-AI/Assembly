 crates/sysmlv2-parser/tests/roundtrip.rs | 231 +++++++++++++++++++++++
 2 files changed, 330 insertions(+), 1 deletion(-)

diff --git a/crates/sysmlv2-model/src/lift.rs b/crates/sysmlv2-model/src/lift.rs
index 14f6c83..16d0da5 100644
--- a/crates/sysmlv2-model/src/lift.rs
+++ b/crates/sysmlv2-model/src/lift.rs
@@ -1012,6 +1012,90 @@ impl<'a> Lifter<'a> {
         self.by_id.get(owner_id).copied()
     }
 
+    /// `DefaultTargetSuccession` has no `isDefault` metamodel property:
+    /// its target-only TransitionUsage shape is disambiguated by its body
+    /// context. State target transitions have that shape too, but must keep
+    /// their `transition ... then` spelling. Only ActionBodyItem contexts
+    /// (also included by CalculationBodyItem and CaseBodyItem) take `else`.
+    fn in_action_body(&self, el: El<'a>) -> bool {
+        if self.dialect != Dialect::Sysml {
+            return false;
+        }
+        let Some(owner) = self.owner_of(el) else {
+            return false;
+        };
+        // Keep aligned with syntax/check.rs def_body_ctx/usage_body_ctx.
+        matches!(
+            def_kind_of(ty(owner)),
+            Some(
+                DefKind::Action
+                    | DefKind::Calc
+                    | DefKind::Constraint
+                    | DefKind::Case
+                    | DefKind::Analysis
+                    | DefKind::Verification
+                    | DefKind::UseCase
+            )
+        ) || matches!(
+            usage_kind_of(ty(owner), self.dialect),
+            Some(
+                UsageKind::Action
+                    | UsageKind::Perform
+                    | UsageKind::Accept
+                    | UsageKind::Send
+                    | UsageKind::Assign
+                    | UsageKind::Terminate
+                    | UsageKind::IfNode
+                    | UsageKind::WhileLoop
+                    | UsageKind::ForLoop
+                    | UsageKind::Merge
+                    | UsageKind::Decide
+                    | UsageKind::Join
+                    | UsageKind::Fork
+                    | UsageKind::Transition
+                    | UsageKind::Calc
+                    | UsageKind::Constraint
+                    | UsageKind::AssertConstraint
+                    | UsageKind::Case
+                    | UsageKind::Analysis
+                    | UsageKind::Verification
+                    | UsageKind::UseCase
+                    | UsageKind::Include
+            )
+        )
+    }
+
+    /// Test the raw relationships as well as the lifted parts: a malformed
+    /// guard/source/trigger/effect that cannot be lifted is still present and
+    /// must never turn a transition into an unconditional default branch.
+    /// Full JSON's implied source memberships are semantic derivations, not
+    /// explicitly written sources.
+    fn has_only_default_transition_parts(&self, el: El<'a>) -> bool {
+        let Some(rels) = el.get("ownedRelationship").and_then(Value::as_array) else {
+            return false;
+        };
+        rels.iter().all(|reference| {
+            let Some(rel) = ref_id(reference).and_then(|id| self.by_id.get(id).copied()) else {
+                return false;
+            };
+            if bval(rel, "isImplied") {
+                return true;
+            }
+            match ty(rel) {
+                "Membership" | "TransitionFeatureMembership" => false,
+                "OwningMembership" => self.first_related(rel).is_some_and(|inner| {
+                    ty(inner) == "SuccessionAsUsage"
+                        || def_kind_of(ty(inner)).is_some()
+                        || crate::metaclass::conforms(ty(inner), "AnnotatingElement")
+                }),
+                // These can be UsageBody members, not transition parts.
+                "FeatureMembership" | "AliasMembership" | "Annotation" | "NamespaceImport"
+                | "MembershipImport" => true,
+                _ => false,
+            }
+        })
+    }
+
     /// An element's declared (short) name, for anonymity tests.
     fn declared_name<'b>(el: El<'b>) -> Option<&'b str> {
         sval(el, "declaredName").or_else(|| sval(el, "declaredShortName"))
@@ -2812,7 +2896,7 @@ impl<'a> Lifter<'a> {
         }
 
         // Kind-specific details.
-        let detail = self.assemble_detail(
+        let mut detail = self.assemble_detail(
             t,
             kind,
             el,
@@ -2829,6 +2913,20 @@ impl<'a> Lifter<'a> {
             satisfy_by,
         );
 
+        if let UsageDetail::Transition {
+            source: None,
+            trigger: None,
+            guard: None,
+            effect: None,
+            target: Some(_),
+            is_default,
+        } = &mut detail
+        {
+            *is_default = declaration.is_empty()
+                && self.in_action_body(el)
+                && self.has_only_default_transition_parts(el);
+        }
+
         let saved_body = std::mem::replace(&mut self.body_featuring, featuring);
         let members = self.lift_members(&body_rels);
         self.body_featuring = saved_body;
