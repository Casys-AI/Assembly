+#[test]
+fn transitions_in_transparent_containers_emit_once_with_semantic_endpoints() {
+    check_transitions(
+        "part container {
+            attribute ok : Boolean;
+            action fast; action slow; action ingest;
+            if ok then fast;
+            else slow;
+        }",
+        View::Action,
+        &[("ingest", "fast", Some("[ok]")), ("ingest", "slow", None)],
+    );
+}
+
+#[test]
+fn named_and_anonymous_decisions_are_native_sources_for_both_conditional_branches() {
+    for (declaration, label) in [("decide branch", "branch"), ("decide", "(choice)")] {
+        check_transitions(
+            &format!(
+                "action def Router {{
+                attribute ok : Boolean;
+                action fast; action slow;
+                {declaration};
+                if ok then fast;
+                else slow;
+            }}"
+            ),
+            View::Action,
+            &[(label, "fast", Some("[ok]")), (label, "slow", None)],
+        );
+    }
+}
