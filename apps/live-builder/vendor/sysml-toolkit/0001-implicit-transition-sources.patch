+type Neighbors = HashMap<(usize, usize), (Option<usize>, Option<usize>)>;
+
 fn charge(steps: &mut usize, amount: usize) -> Option<()> {
     *steps = steps.saturating_add(amount);
     (*steps <= crate::eval::MAX_STEPS).then_some(())
 }
 
+/// The previous/next occurrence of each member, using the same lexical rule
+/// for successions and target transitions. Parameters and connectors do not
+/// advance the sequence; a message (a Flow without ends) does. Conditional
+/// transitions likewise leave the previous occurrence in place for the next branch.
+fn neighbors(
+    b: &Builder,
+    raw: &StoredStructure,
+    owner: usize,
+    steps: &mut usize,
+) -> Option<Neighbors> {
+    let mut members = Vec::new();
+    charge(steps, b.elements[owner].owned_relationships.len())?;
+    for &rel in &b.elements[owner].owned_relationships {
+        let relation = b.elements.get(rel)?;
+        // Non-owning memberships (including `first start`) are references,
+        // not declarations in this sequence. An unresolved reference here
+        // cannot invalidate otherwise complete lexical occurrence evidence.
+        if !is_a!(relation, "OwningMembership") {
+            continue;
+        }
+        let member = membership_evidence::member(b, raw, owner, rel, steps)?;
+        let row = &b.elements[member];
+        let parameter = is_a!(relation, "ParameterMembership")
+            || ((is_a!(b.elements[owner], "Behavior") || is_a!(b.elements[owner], "Step"))
+                && row.props.get("direction").is_some_and(|v| !v.is_null()));
+        let message = if is_a!(row, "FlowUsage") {
+            charge(steps, row.owned_relationships.len())?;
+            let mut no_ends = true;
+            for &r in &row.owned_relationships {
+                let relationship = b.elements.get(r)?;
+                if is_a!(relationship, "FeatureMembership") {
+                    let feature = membership_evidence::member(b, raw, member, r, steps)?;
+                    no_ends &= b.elements[feature]
+                        .props
+                        .get("isEnd")
+                        .and_then(|v| v.as_bool())
+                        != Some(true);
+                }
+            }
+            no_ends
+        } else {
+            false
+        };
+        let occurrence = is_a!(relation, "FeatureMembership")
+            && !parameter
+            && is_a!(row, "OccurrenceUsage")
+            && !is_a!(row, "TransitionUsage")
+            && (!is_a!(row, "Connector") || message);
+        members.push((rel, member, occurrence));
+    }
+    charge(steps, members.len().saturating_mul(2))?;
+    let mut neighbors = HashMap::new();
+    let mut previous = None;
+    for &(rel, member, occurrence) in &members {
+        neighbors.insert((rel, member), (previous, None));
+        if occurrence {
+            previous = Some(member);
+        }
+    }
+    let mut next = None;
+    for &(rel, member, occurrence) in members.iter().rev() {
+        neighbors.get_mut(&(rel, member)).expect("checked member").1 = next;
+        if occurrence {
+            next = Some(member);
+        }
+    }
+    Some(neighbors)
+}
+
+/// A transition's authored source feature, including a feature chain. `None`
+/// inside `Some` proves that no source was authored; incomplete or invalid
+/// explicit source evidence is never permission to infer a replacement.
+fn explicit_source(
+    b: &Builder,
+    raw: &StoredStructure,
+    transition: usize,
+    steps: &mut usize,
+) -> Option<Option<usize>> {
+    charge(steps, b.elements[transition].owned_relationships.len())?;
+    for &rel in &b.elements[transition].owned_relationships {
+        let relation = b.elements.get(rel)?;
+        if !is_a!(relation, "Membership") || is_a!(relation, "FeatureMembership") {
+            continue;
+        }
+        let member = membership_evidence::member(b, raw, transition, rel, steps)?;
+        if is_a!(relation, "OwningMembership") && is_a!(b.elements[member], "Succession") {
+            continue;
+        }
+        if is_a!(b.elements[member], "Feature") {
+            // Explicit feature chains remain authoritative. Their internal
+            // succession projection is not this lexical shorthand rule.
+            if super::type_relations::checked_feature_target(
+                b,
+                raw,
+                member,
+                &b.elements[member].owned_relationships,
+                b.explicit_len(),
+                steps,
+            )?
+            .is_some()
+            {
+                return None;
+            }
+            return (member != transition && is_a!(b.elements[member], "ActionUsage"))
+                .then_some(Some(member));
+        }
+        // A plain Membership spells a source even if its member has the
+        // wrong metaclass. OwningMemberships may instead own the succession.
+        if !is_a!(relation, "OwningMembership") {
+            return None;
+        }
+    }
+    Some(None)
+}
+
+/// Implicit TransitionUsage source Membership recipes. Kept out of the
+/// authored graph, so compact interchange, source text and digests retain the
+/// user's shorthand. The shared publisher owns their identities and carriers.
+/// A prepared library has already published its own rows; only the appended
+/// source slice is scanned when extending that library.
+pub(super) fn transition_sources_from(
+    b: &mut Builder,
+    start: usize,
+    steps: &mut usize,
+) -> Option<Vec<(usize, usize)>> {
+    let limit = b.explicit_len();
+    charge(steps, limit.saturating_sub(start))?;
+    let transitions: Vec<_> = (start..limit)
+        .filter(|&i| b.is_authored(i) && b.elements[i].ty == "TransitionUsage")
+        .collect();
+    transition_sources(b, transitions, steps)
+}
+
+/// Infer sources for an already charged authored TransitionUsage slice. Static
+/// planning and succession planning gather this during their existing row scan,
+/// so models without transitions pay no additional whole-model scan.
+pub(super) fn transition_sources(
+    b: &mut Builder,
+    transitions: Vec<usize>,
+    steps: &mut usize,
+) -> Option<Vec<(usize, usize)>> {
+    if transitions.is_empty() {
+        return Some(Vec::new());
+    }
+    let raw = StoredStructure::for_query(b, steps)?;
+    let domains = raw.membership_domains(b, steps)?;
+    let mut bodies = HashMap::new();
+    let mut out = Vec::new();
+    for transition in transitions {
+        charge(steps, 1)?;
+        if !domains.owner_complete(transition)
+            || explicit_source(b, &raw, transition, steps) != Some(None)
+        {
+            continue;
+        }
+        let Some(membership) = b.elements[transition].owning_relationship else {
+            continue;
+        };
+        let Some(Some(owner)) = raw.carrier(b, membership) else {
+            continue;
+        };
+        if !domains.owner_complete(owner) {
+            continue;
+        }
+        if let Entry::Vacant(entry) = bodies.entry(owner) {
+            entry.insert(neighbors(b, &raw, owner, steps).unwrap_or_default());
+            charge(steps, 0)?;
+        }
+        if let Some(&(Some(source), _)) = bodies[&owner].get(&(membership, transition)) {
+            if source != transition && is_a!(b.elements[source], "ActionUsage") {
+                out.push((transition, source));
+            }
+        }
+    }
+    charge(steps, 0)?;
+    Some(out)
+}
