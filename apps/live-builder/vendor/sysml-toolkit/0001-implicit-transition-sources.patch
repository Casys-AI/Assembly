+        "state def Modes {
+            state idle; state busy; state stopped;
+            transition route first idle if true then busy;
+            transition stop first busy then stopped;
+        }",
+        View::State,
+        &[("idle", "busy", Some("[true]")), ("busy", "stopped", None)],
+    );
+}
