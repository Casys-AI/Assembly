+#[cfg(test)]
+mod transition_tests {
+    use super::*;
+    use crate::{
+        json::{Derived, DerivedValue, ElementRef, Reference, ResolvedModel},
+        model::Model,
+    };
+    use serde_json::json;
+
+    fn fixture(source: &str) -> (Model, ResolvedModel) {
+        let mut model = Model::new();
+        let parsed = model.add_source("transitions.sysml", source);
+        assert!(parsed.diagnostics.is_empty(), "{:?}", parsed.diagnostics);
+        let resolved = ResolvedModel::build(&model);
+        (model, resolved)
+    }
+    fn transitions(r: &ResolvedModel) -> Vec<ElementRef> {
+        r.user_elements()
+            .filter(|&e| r.element_type(e) == "TransitionUsage")
+            .collect()
+    }
+    fn source(r: &mut ResolvedModel, transition: ElementRef) -> Option<ElementRef> {
+        match r.derived(transition, "source") {
+            Derived::Value(value) => value.element(),
+            other => panic!("{other:?}"),
+        }
+    }
+    fn assert_source(r: &mut ResolvedModel, transition: ElementRef, name: &str) {
+        let expected = r.resolve_qualified(name).unwrap();
+        assert_eq!(source(r, transition), Some(expected));
+        assert_eq!(r.transition_parts(transition).source, Some(expected));
+        assert_eq!(
+            r.property(transition, "source").unwrap(),
+            json!({"@id": r.element_id(expected).to_string()})
+        );
+        let succession = r.d_succession(transition).unwrap();
+        assert_eq!(
+            r.derived(succession, "sourceFeature"),
+            Derived::Value(DerivedValue::Reference(Reference::Element(expected)))
+        );
+        let related = r.derived(succession, "relatedFeature");
+        assert!(
+            matches!(related, Derived::Value(DerivedValue::References(ref ends)) if ends.len() == 2 && ends[0].element() == Some(expected)),
+            "{related:?}"
+        );
+        assert_ne!(expected, transition);
+    }
+
+    #[test]
+    fn implicit_transition_sources_are_shared_by_all_semantic_reads_and_full_json() {
+        let (model, mut r) =
+            fixture("action a { action b; action c; decide d; if true then b; else c; }");
+        let compact = r.built_compact_json_with_units().unwrap();
+        let ts = transitions(&r);
+        assert_eq!(ts.len(), 2);
+        for &t in &ts {
+            assert_source(&mut r, t, "a::d");
+        }
+        let full = crate::full::resolved_to_full_json(&mut r, &model, Default::default()).unwrap();
+        let rows = full.as_array().unwrap();
+        let source = r.resolve_qualified("a::d").unwrap();
+        let source_id = r.element_id(source).to_string();
+        for t in ts {
+            let id = r.element_id(t).to_string();
+            let row = rows.iter().find(|row| row["@id"] == id).unwrap();
+            assert_eq!(row["source"], json!({"@id": source_id}));
+            let memberships: Vec<_> = r
+                .implied_relationships(t)
+                .into_iter()
+                .filter(|&m| r.element_type(m) == "Membership")
+                .collect();
+            assert_eq!(memberships.len(), 1);
+            let membership_id = r.element_id(memberships[0]).to_string();
+            assert!(
+                row["ownedRelationship"]
+                    .as_array()
+                    .unwrap()
+                    .contains(&json!({"@id": membership_id}))
+            );
+            let membership = rows.iter().find(|row| row["@id"] == membership_id).unwrap();
+            assert_eq!(membership["memberElement"], json!({"@id": source_id}));
+            assert_eq!(membership["isImplied"], true);
+        }
+        assert_eq!(r.built_compact_json_with_units().unwrap(), compact);
+        assert_eq!(crate::json::model_to_compact_json(&model), compact.0);
+    }
