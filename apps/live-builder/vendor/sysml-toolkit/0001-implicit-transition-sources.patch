+#[test]
+fn explicit_unresolved_transition_sources_do_not_fall_back_to_a_previous_node() {
+    for (declaration, node, view) in [
+        ("action def Router", "action", View::Action),
+        ("state def Modes", "state", View::State),
+    ] {
+        check_transitions(
+            &format!(
+                "{declaration} {{
+                {node} target; {node} previous;
+                transition first missing if true then target;
+            }}"
+            ),
+            view,
+            &[],
+        );
+    }
+}
