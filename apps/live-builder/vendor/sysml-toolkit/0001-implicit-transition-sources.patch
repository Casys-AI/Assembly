--- /dev/null
+++ b/crates/sysmlv2-viz/tests/transition_semantics.rs
@@ -0,0 +1,198 @@
+//! Graph and PlantUML consume the same semantic transition endpoints.
+use sysmlv2_model::{json::ResolvedModel, model::Model};
+use sysmlv2_viz::{View, VizOptions, graph, plantuml};
+
+fn check_transitions(source: &str, view: View, expected: &[(&str, &str, Option<&str>)]) {
+    let mut model = Model::new();
+    let unit = model.add_source("transitions.sysml", source);
+    assert!(unit.diagnostics.is_empty(), "{:?}", unit.diagnostics);
+    let mut resolved = ResolvedModel::build(&model);
+    let options = VizOptions::default().with_view(view);
+    let graph = graph(&mut resolved, None, &options).unwrap();
+    let nodes = graph["nodes"].as_array().unwrap();
+    let edges = graph["edges"].as_array().unwrap();
+    assert_eq!(edges.len(), expected.len(), "{graph}");
+    let uml = plantuml(&mut resolved, None, &options);
+    assert_eq!(
+        uml.lines().filter(|line| line.contains(" --> ")).count(),
+        expected.len(),
+        "{uml}"
+    );
+    let node_id =
+        |label: &str| nodes.iter().find(|node| node["label"] == label).unwrap()["id"].clone();
+    let alias = |label: &str| {
+        let marker = format!("\"{label}\" as ");
+        let start = uml.find(&marker).unwrap() + marker.len();
+        uml[start..].split_whitespace().next().unwrap()
+    };
+    for &(source, target, label) in expected {
+        let edge = edges
+            .iter()
+            .find(|edge| edge["source"] == node_id(source) && edge["target"] == node_id(target))
+            .unwrap_or_else(|| panic!("missing {source} -> {target}: {graph}"));
+        assert_eq!(edge["kind"], "transition");
+        assert_eq!(edge["metaclass"], "TransitionUsage");
+        assert_eq!(edge["directed"], true);
+        assert_eq!(edge["label"].as_str(), label);
+        let element = resolved
+            .element_by_id(edge["id"].as_str().unwrap())
+            .unwrap();
+        assert_eq!(resolved.element_type(element), "TransitionUsage");
+        assert_eq!(
+            resolved.declaration_position(element).unwrap().0,
+            "transitions.sysml"
+        );
+        let expected_line = format!(
+            "{} --> {}{}",
+            alias(source),
+            alias(target),
+            label.map(|label| format!(" : {label}")).unwrap_or_default(),
+        );
+        assert!(
+            uml.lines().any(|line| line.trim() == expected_line),
+            "{uml}"
+        );
+    }
+}
+
+#[test]
+fn explicit_guarded_action_transitions_render_for_definitions_and_usages() {
+    for declaration in ["action def Router", "action router", "action"] {
+        check_transitions(
+            &format!(
+                "{declaration} {{
+                attribute ok : Boolean;
+                action ingest; action fast; action slow;
+                transition route first ingest if ok then fast;
+                first ingest if not ok then slow;
+            }}"
+            ),
+            View::Action,
+            &[
+                ("ingest", "fast", Some("[ok]")),
+                ("ingest", "slow", Some("[not ok]")),
+            ],
+        );
+    }
+}
+
+#[test]
+fn implicit_action_transition_sources_and_default_branches_match_plantuml() {
+    for declaration in ["action def Router", "action router", "action"] {
+        for transition in ["transition", ""] {
+            check_transitions(
+                &format!(
+                    "{declaration} {{
+                    attribute ok : Boolean;
+                    action fast; action slow; action ingest;
+                    {transition} if ok then fast;
+                    else slow;
+                }}"
+                ),
+                View::Action,
+                &[("ingest", "fast", Some("[ok]")), ("ingest", "slow", None)],
+            );
+        }
+    }
+}
+
+#[test]
+fn explicit_and_implicit_state_transition_sources_match_plantuml() {
+    for declaration in ["state def Modes", "state modes", "state"] {
+        for transition in ["transition", ""] {
+            for source in ["first idle", ""] {
+                check_transitions(
+                    &format!(
+                        "{declaration} {{
+                        attribute ok : Boolean;
+                        state busy; state stopped; state idle;
+                        {transition} {source} if ok then busy;
+                        else stopped;
+                    }}"
+                    ),
+                    View::State,
+                    &[("idle", "busy", Some("[ok]")), ("idle", "stopped", None)],
+                );
+            }
+        }
+    }
+}
